# .devcontainer/versions.env — devcontainer-mcp-provisioning-r1
#
# Single source of truth for OSS-local MCP server version pins.
# Authored per Plan T1.3; values from verify-at-execution.md §H-1..§H-4 + ADR-0040.
# Consumed by: postCreate.sh (T3.4 install steps), .mcp.json (T2.4 env-block indirection per ADR-0039).
#
# Convention: `<PIN_TBD>` placeholder per I-DR-003 / Plan §D-2 (cycle-3 verify-at-execution §D-2)
# is used ONLY where a pin hasn't been selected yet. All 5 OSS-local pins below are SET.

# Serena MCP — Python-audit-surface allowlist per ADR-0040; pinned strictly below v1.3.0
# (pending base_modes→added_modes review per ADR-0040 known-unknown).
# Installed via canonical upstream method: `uv tool install serena-agent==${SERENA_VERSION}`
# (PyPI package `serena-agent`, NOT the git-ref form ADR-0041 originally specified —
# upstream README explicitly disrecommends the git-ref form).
SERENA_VERSION=1.2.0

# mcp-openapi-schema removed 2026-05-24 per MCP-provisioning-postmortem 2026-05-24:
# - upstream npm package (hannesj/mcp-openapi-schema) is abandoned (single 2025-03-13 release)
# - no openapi.yaml exists in this repo for it to serve
# - no public Anthropic OpenAPI spec URL exists to point a replacement (explorer) at
# - design-api had no working spec server; removing eliminates the broken entry
# Reopen via a focused feature when a real OpenAPI spec is checked in.

# actionlint-mcp — pinned to HEAD of main on hongkongkiwi/actionlint-mcp per
# verify-at-execution §H-1. (Cycle-3 reconciliation corrected the upstream
# org from the wrong "2manymws/" to the correct "hongkongkiwi/".)
ACTIONLINT_MCP_SHA=7441fe042c995cbb1bb4b97fce71f9ed3b36d5ef

# Terraform MCP — HashiCorp's official server, pinned to latest stable
# (published 2026-04-28). SHA256 + GPG verification per verify-at-execution §H-2.
TERRAFORM_MCP_VERSION=0.5.2

# GitNexus — npm package per verify-at-execution §H-4 (cycle-3 reconciliation
# corrected install path from "uvx" to "npm install -g" / "npx -y").
# Latest stable on npm; GITNEXUS_SKIP_OPTIONAL_GRAMMARS=1 honored.
GITNEXUS_TAG=1.6.5
