{
  "name": "feature-pipeline (claude-code-native)",

  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": { "PYTHON_VERSION": "3.11" }
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "installOhMyZsh": false,
      "upgradePackages": false,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "onCreateCommand": "claude --version && python3 --version && node --version && go version && gh --version",

  "postCreateCommand": ".devcontainer/postCreate.sh",
  "postStartCommand": ".devcontainer/postStart.sh",

  "forwardPorts": [],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "editor.formatOnSave": false,
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "markdown.extension.toc.levels": "2..4"
      }
    }
  },

  "remoteUser": "vscode",

  "containerEnv": {
    "EDITOR": "code --wait",
    "PAGER": "less -R",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "EXA_API_KEY": "${localEnv:EXA_API_KEY}",
    "TFE_TOKEN": "${localEnv:TFE_TOKEN}",
    "GITNEXUS_SKIP_OPTIONAL_GRAMMARS": "1",
    "SERENA_VERSION": "1.2.0",
    "ACTIONLINT_MCP_SHA": "7441fe042c995cbb1bb4b97fce71f9ed3b36d5ef",
    "GITNEXUS_TAG": "1.6.5",
    "TERRAFORM_MCP_VERSION": "0.5.2"
  },

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
