{
  "mcpServers": {
    "actionlint-mcp": {
      "command": "actionlint-mcp",
      "args": []
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    },
    "gitnexus": {
      "command": "npx",
      "args": ["-y", "gitnexus@${GITNEXUS_TAG}", "mcp"],
      "env": {
        "GITNEXUS_SKIP_OPTIONAL_GRAMMARS": "1"
      }
    },
    "mcp-openapi-schema": {
      "command": "npx",
      "args": ["-y", "mcp-openapi-schema@${MCP_OPENAPI_SCHEMA_VERSION}"]
    },
    "serena": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/oraios/serena@${SERENA_REF}", "serena"]
    },
    "terraform-mcp": {
      "command": "terraform-mcp",
      "args": [],
      "env": {
        "TFE_TOKEN": "${TFE_TOKEN}"
      }
    }
  }
}
