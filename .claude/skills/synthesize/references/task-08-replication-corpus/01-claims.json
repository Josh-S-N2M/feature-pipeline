      "entities": [],
      "confidence": "high",
      "notes": null
    },
    {
      "id": "C-0050",
      "text": "ADR option comparison requires a minimum of 3 options.",
      "source_uri": "/mnt/user-data/uploads/technical-designer.md",
      "source_type": "internal_audit",
      "source_provenance": "internal",
      "assumed_substrate": "claude_code",
      "date": null,
      "entities": [],
      "confidence": "high",
      "notes": "From ADR Checklist"
    },
    {
      "id": "C-0051",
      "text": "Architecture and data flow diagrams are mandatory in Design Docs.",
      "source_uri": "/mnt/user-data/uploads/technical-designer.md",
      "source_type": "internal_audit",
      "source_provenance": "internal",
      "assumed_substrate": "claude_code",
      "date": null,
      "entities": [],
      "confidence": "high",
      "notes": null
    },
