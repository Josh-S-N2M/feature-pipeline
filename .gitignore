# Claude Code user-local settings — never commit.
# Per cc-critique audit + KB-cc-platform `settings.local.json` convention:
# this file is per-developer and may contain experimental allow-list rules.
.claude/settings.local.json

# Optional: Claude Code agent-local memory directory (per-developer).
.claude/agent-memory-local/

# Common ignores
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# Claude Code runtime artifacts (MCP install sentinels, poststart timestamp,
# mcp-events.jsonl). All contents are ephemeral and regenerated by
# .devcontainer/postCreate.sh + postStart.sh on each codespace start. The
# .gitkeep anchor is kept so the directory itself remains tracked.
.claude/runtime/*
!.claude/runtime/.gitkeep

# Claude Code session-local audit-trail logs (issue-capture-author etc.)
# Per Q-CC-4 + AC-NFR-7-a: runtime audit trail, regenerated each session,
# not committable signal.
.claude/logs/*.jsonl
