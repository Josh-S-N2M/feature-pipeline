    {
      "id": "C-0046",
      "text": "The list-security-schemes tool reports the security schemes declared in the spec — it does not authenticate against the API the spec describes.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-002-mcp-openapi-schema.md",
