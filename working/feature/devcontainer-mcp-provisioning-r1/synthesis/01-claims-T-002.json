    {
      "id": "C-0064",
      "text": "The install command `npx -y mcp-openapi-schema@0.0.1 <path>` works on Debian-bookworm + Node/Python toolchain once ghcr.io/devcontainers/features/node:1 is added; Python toolchain not required (Node-only).",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-002-mcp-openapi-schema.md",
