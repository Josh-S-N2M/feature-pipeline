      "confidence": "medium",
      "notes": null
    },
    {
      "id": "C-0063",
      "text": "Pre-1.0 versions provide no semver guarantees, so unpinned use is unsafe for a reproducible devcontainer.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-002-mcp-openapi-schema.md",
