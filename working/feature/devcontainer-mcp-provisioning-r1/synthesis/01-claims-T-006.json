    },
    {
      "id": "C-0012",
      "text": "The Exa MCP server's auth resolver accepts an `Authorization: Bearer …` header (also accepts JWTs for OAuth flows).",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-006-exa.md",
