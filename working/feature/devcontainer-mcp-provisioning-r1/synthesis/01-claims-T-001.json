    {
      "id": "C-0026",
      "text": "JetBrains-only Serena tools — `move`, `inline`, `search in project dependencies`, `type hierarchy`, and breakpoint/variable debugging — are NOT exposed through MCP.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
