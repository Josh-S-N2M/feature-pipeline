    {
      "id": "C-0027",
      "text": "The exact MCP tool-id strings (consumed by Claude Code's `tools:` allowlist) are stable in snake_case form but should be confirmed at integration time by running `claude mcp list` against an installed Serena instance.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
