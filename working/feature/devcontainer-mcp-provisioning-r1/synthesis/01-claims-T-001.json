      "entities": [],
      "confidence": "high",
      "notes": "F-4 refactoring enumeration (factual)."
    },
    {
      "id": "C-0024",
      "text": "Serena's basic non-symbolic utility tools include `search_for_pattern` (regex), `replace_content` (regex/literal), `list_dir`, `find_file`, `read_file`, and `execute_shell_command`.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
