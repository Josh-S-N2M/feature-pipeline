      "entities": [],
      "confidence": "high",
      "notes": "F-4 retrieval tools enumeration (factual)."
    },
    {
      "id": "C-0022",
      "text": "Serena's symbolic editing tools include `replace_symbol_body`, `insert_after_symbol`, `insert_before_symbol`, and `safe_delete`.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
