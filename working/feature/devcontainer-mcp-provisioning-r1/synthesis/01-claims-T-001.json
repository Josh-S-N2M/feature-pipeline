      "entities": [],
      "confidence": "high",
      "notes": "F-1 caveat (factual)."
    },
    {
      "id": "C-0007",
      "text": "Serena's docs warn that experimental Python 3.12+ may have LSP compatibility issues for some language backends.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
      "assumed_substrate": "claude_code",
      "date": "2026-05-23",
      "entities": [],
      "confidence": "high",
      "notes": "F-1 caveat (risk)."
    },
    {
      "id": "C-0008",
      "text": "Upstream explicitly warns not to install Serena via an MCP or plugin marketplace because those carry outdated commands.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-001-serena.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
