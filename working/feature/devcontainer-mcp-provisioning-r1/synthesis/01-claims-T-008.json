      "entities": [],
      "confidence": "high",
      "notes": null
    },
    {
      "id": "C-0020",
      "text": "GitNexus uses lazy KuzuDB connection opening, so repos analyzed after server start are discoverable without restart.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-008-gitnexus.md",
      "source_type": "internal_audit",
