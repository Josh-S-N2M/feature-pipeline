    {
      "id": "C-0034",
      "text": "The default `npm install -g gitnexus` performs vendored Tree-sitter grammar builds for tree-sitter-dart, tree-sitter-proto, and tree-sitter-swift.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-008-gitnexus.md",
      "source_type": "internal_audit",
      "source_provenance": "internal",
      "assumed_substrate": "generic",
      "date": "2026-05-23",
      "entities": [],
      "confidence": "high",
      "notes": null
    },
    {
      "id": "C-0035",
      "text": "Setting `GITNEXUS_SKIP_OPTIONAL_GRAMMARS=1` before install skips the vendored grammar builds; the resulting install drops Dart/Proto/Swift parsing but keeps the 14+ remaining tree-sitter languages (Python, JS, TS, Rust, Go, Java, etc.).",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-008-gitnexus.md",
      "source_type": "internal_audit",
      "source_provenance": "internal",
