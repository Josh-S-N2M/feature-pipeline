      "notes": "Recommendation/decision claim from the executive summary."
    },
    {
      "id": "C-0008",
      "text": "Using the remote HTTP endpoint avoids version drift on a vendor-controlled service that re-indexes upstream library docs constantly.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-005-context7.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
      "assumed_substrate": "claude_code",
      "date": "2026-05-23",
      "entities": [],
      "confidence": "high",
      "notes": null
    },
    {
      "id": "C-0009",
      "text": "Using the remote HTTP endpoint eliminates a Node process from the always-on session.",
