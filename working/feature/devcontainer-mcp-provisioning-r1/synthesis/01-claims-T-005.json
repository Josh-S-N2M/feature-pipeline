    {
      "id": "C-0046",
      "text": "Context7 is a documentation-lookup convenience, not a load-bearing pipeline dependency; a degraded Context7 only degrades the quality of doc-lookup hints, it does not block the pipeline.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-005-context7.md",
