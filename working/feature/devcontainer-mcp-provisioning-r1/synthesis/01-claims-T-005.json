      "entities": [],
      "confidence": "high",
      "notes": null
    },
    {
      "id": "C-0007",
      "text": "For project-scoped always-on use under the feature's Codespaces baseline, the recommended transport is remote HTTP to https://mcp.context7.com/mcp with the API key supplied as a request header sourced from the CONTEXT7_API_KEY Codespaces secret.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-005-context7.md",
      "source_type": "community_blog",
      "source_provenance": "internal",
