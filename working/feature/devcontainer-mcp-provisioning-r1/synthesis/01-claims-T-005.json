    },
    {
      "id": "C-0031",
      "text": "For the local stdio path, pin to a specific version (e.g., @upstash/context7-mcp@3.0.0 or whichever is current at design time) rather than @latest.",
      "source_uri": "/workspaces/feature-pipeline/working/feature/devcontainer-mcp-provisioning-r1/research-notes/T-005-context7.md",
